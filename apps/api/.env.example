PORT=4000

CORS_ENABLED=false
CORS_ORIGIN=http://localhost:3000
# 소셜 로그인이 끝난 뒤 돌려보낼 웹 주소
WEB_URL=http://localhost:3000

# 앱이 쓰는 연결 (Supabase면 Transaction pooler, 포트 6543)
DATABASE_URL="postgresql://postgres.your-project-ref:{password}@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?schema=public&pgbouncer=true"
# prisma migrate가 쓰는 직접 연결 (Supabase Connect > Session pooler 또는 Direct connection, 포트 5432)
DIRECT_URL="postgresql://postgres.your-project-ref:{password}@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?schema=public"

# access 토큰(JWT) 서명 키. 32자 이상 랜덤 문자열 (openssl rand -hex 32 등으로 생성). 바꾸면 모든 로그인이 끊긴다
JWT_ACCESS_SECRET=change-me-to-a-random-string-at-least-32-chars

# Google 로그인: Google Cloud Console > API 및 서비스 > 사용자 인증 정보 > OAuth 클라이언트 ID(웹 애플리케이션)
# "승인된 리디렉션 URI"에 GOOGLE_REDIRECT_URI 값을 그대로 등록한다
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/social/google/callback

# Supabase는 DB 호스팅·Storage·Realtime에만 쓴다 (인증은 API가 직접 처리)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_publishable_your_anon_key

# Storage > New bucket 으로 만들고 Public bucket 체크 (이미지 업로드 결과 URL을 바로 공개로 쓰기 위함)
SUPABASE_STORAGE_BUCKET=card-images

# 다른 사용자로 인한 포인트·알림 변경을 Realtime Broadcast로 알릴 때, 채널명을 추측 못 하게 감추는 서버 전용 시크릿
# (아무 랜덤 문자열이나 가능. openssl rand -hex 32 등으로 생성)
REALTIME_CHANNEL_SECRET=change-me
