// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum CardCategory {
  CAT
  DOG
}

enum SaleStatus {
  ON_SALE
  SOLD_OUT
  CANCELED
}

enum ExchangeStatus {
  ACCEPTED
  REJECTED
  PENDING
  CANCELED
}

enum NotificationType {
  SALE_CANCELED_EXCHANGE
  SALE_SOLD
  SALE_SOLDOUT_EXCHANGE
  EXCHANGE_RECEIVED
  EXCHANGE_ACCEPTED
  EXCHANGE_REJECTED_BY_ACCEPT
  EXCHANGE_REJECTED
  EXCHANGE_CANCELED_BY_OFFERER
}

model User {
  id          String    @id @default(uuid())
  nickname    String    @unique
  email       String    @unique
  // "local"(이메일/비밀번호) 또는 "google". providerUid는 소셜 계정의 고유 ID(Google sub)이며 local은 null
  provider     String
  providerUid  String?
  // local 계정의 scrypt 해시 (lib/password.js 형식). 소셜 계정은 null
  passwordHash String?
  point        BigInt    @default(0)
  lastDrawAt   DateTime?
  createdAt    DateTime  @default(now())

  refreshTokens RefreshToken[]
  notifications Notification[]
  uploads       ImageData[]
  ownedCards    Card[]     @relation("CardOwner")
  createdCards  Card[]     @relation("CardCreator")
  sales         Sale[]

  @@unique([provider, providerUid])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  content   String
  targetId  String
  isRead    Boolean          @default(false)
  deletedAt DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])
}

model ImageData {
  id         String       @id @default(uuid())
  uploaderId String
  imageUrl   String
  category   CardCategory
  score      Json?
  createdAt  DateTime     @default(now())

  card     Card?
  uploader User @relation(fields: [uploaderId], references: [id])
}

model Card {
  id          String   @id @default(uuid())
  ownerId     String
  createdById String
  name        String
  filterType  Int
  tag         String
  topScore    Int
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  imageId     String   @unique

  owner   User      @relation("CardOwner", fields: [ownerId], references: [id])
  creator User      @relation("CardCreator", fields: [createdById], references: [id])
  image   ImageData @relation(fields: [imageId], references: [id])

  sales            Sale[]
  offeredExchanges Exchange[] @relation("OfferedCard")
}

model Sale {
  id          String     @id @default(uuid())
  cardId      String
  sellerId    String
  description String?
  canExchange Boolean    @default(false)
  status      SaleStatus @default(ON_SALE)
  price       BigInt
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  closedAt    DateTime?

  card      Card       @relation(fields: [cardId], references: [id])
  seller    User       @relation(fields: [sellerId], references: [id])
  exchanges Exchange[]
}

model Exchange {
  id          String         @id @default(uuid())
  saleId      String
  offerCardId String
  message     String?
  status      ExchangeStatus @default(PENDING)
  createdAt   DateTime       @default(now())
  respondedAt DateTime?

  sale      Sale @relation(fields: [saleId], references: [id])
  offerCard Card @relation("OfferedCard", fields: [offerCardId], references: [id])
}

// 추후 고려사항 (지금 당장 필요하진 않으나, 데이터가 쌓인 뒤 조회가 느려지면 검토)
// @@index([cardId, status])              on Sale
// @@index([userId, deletedAt])           on Notification
// @@index([category])                    on ImageData

// 로그인 세션별 리프레시 토큰. 원문은 쿠키로만 내려가고 DB에는 SHA-256 해시만 저장한다.
// 재발급할 때마다 기존 행을 지우고 새 행을 만든다(rotation)
model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
