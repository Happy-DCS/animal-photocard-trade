{
  "name": "animal-photocard-trade",
  "private": true,
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm --prefix apps/web run lint && npm --prefix apps/api run lint",
    "build": "npm --prefix apps/web run build",
    "prepare": "husky",
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm --prefix apps/api run dev\" \"npm --prefix apps/web run dev\"",
    "dev:api": "npm --prefix apps/api run dev",
    "dev:web": "npm --prefix apps/web run dev"
  },
  "lint-staged": {
    "*.{json,css,md,yml,yaml}": "prettier --write",
    "apps/web/**/*.{js,jsx,mjs,cjs}": [
      "prettier --write",
      "npm --prefix apps/web run lint:fix --"
    ],
    "apps/api/**/*.{js,mjs,cjs}": [
      "prettier --write",
      "npm --prefix apps/api run lint:fix --"
    ]
  },
  "devDependencies": {
    "concurrently": "^9.2.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "3.9.6"
  }
}
